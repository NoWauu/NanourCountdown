# Copy to `.env` for local runs, paste into Vercel project settings, or pass as
# Docker build args. Anything you leave out falls back to src/config.ts.

# Train leaves — the page starts running a train animation from this moment.
VITE_DEPARTS_AT=2026-08-11T07:35:00+02:00

# Landing in her city, ISO 8601 with an explicit offset (+02:00 is Paris in summer).
VITE_ARRIVES_AT=2026-08-11T11:46:00+02:00

# The day you actually move in together.
VITE_MOVES_IN_AT=2026-08-13T10:00:00+02:00

# When the wait started — sets where the journey line begins.
VITE_WAIT_STARTED_AT=2026-07-24T21:20:40+02:00

VITE_FROM_CITY=Esbly
VITE_TO_CITY=Brest
VITE_HOME_LABEL=our place

# Leg one: until you land.
VITE_EYEBROW=until I land in Brest
VITE_MESSAGE=One last countdown, then no more counting.

# Leg two: landed, not moved in yet.
VITE_SETTLING_EYEBROW=until we live together
VITE_SETTLING_MESSAGE=Same city now. Two more sleeps and the keys are ours.

# Once you live together.
VITE_ARRIVED_MESSAGE=I'm here. Open the door.

# Names on the two step markers.
VITE_ARRIVAL_STEP=I land
VITE_MOVE_IN_STEP=we move in

VITE_LOCALE=en-GB
VITE_TIME_ZONE=Europe/Paris

# How early the train pulls into the platform, in seconds (default 300 = 5 min).
# Drop it to something small to watch the whole sequence quickly.
VITE_BOARDING_LEAD_SECONDS=300

# Counter reading the packing scene comes in on (default 2 = it starts at J-2).
# From there until the train pulls in, he is at home filling a case.
VITE_PACKING_FROM_DAY=2
